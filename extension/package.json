{
  "name": "@sfdt/extension",
  "version": "0.13.0",
  "description": "Chrome MV3 extension for Salesforce admin and developer tools. WXT + TypeScript.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint entrypoints features lib ui test",
    "postinstall": "wxt prepare || true",
    "test": "vitest run",
    "audit:ui": "node scripts/ui-audit.mjs"
  },
  "dependencies": {
    "@sfdt/flow-core": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@vitest/coverage-v8": "^4.1.4",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4",
    "wxt": "^0.21.3"
  }
}
