{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Recording verdict",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/VERDICT.md\" ] && node \"$d/tools/record-verdict.mjs\" --file \"$d/VERDICT.md\" --log-dir \"$d/logs\" && rm -f \"$d/VERDICT.md\" || true"
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Preparing sfdt workspace",
            "command": "d=$(jq -r '.cwd // empty'); cd \"${d:-.}\" || exit 0; [ -d node_modules ] || npm ci; npm run --silent check:all-contracts"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ]
  }
}
